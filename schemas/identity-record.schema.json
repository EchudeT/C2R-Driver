{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driver-port-factory.local/schemas/identity-record.schema.json",
  "type": "object",
  "required": ["canonical_name", "bus", "device_scope", "source_paths", "confirmed"],
  "properties": {
    "canonical_name": {"type": "string", "minLength": 1},
    "bus": {"type": "string", "minLength": 1},
    "device_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confirmed": {"const": true},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
