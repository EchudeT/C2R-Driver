{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driver-port-factory.local/schemas/migration-envelope.schema.json",
  "type": "object",
  "required": [
    "source_platform",
    "target_platform",
    "user_supplied_driver_name",
    "canonical_source_driver_name",
    "source_driver_entry_or_repository_hint",
    "device_family",
    "bus_or_transport",
    "candidate_device_ids",
    "intended_subset",
    "excluded_variants",
    "identity_status",
    "confirmation_basis"
  ],
  "properties": {
    "canonical_source_driver_name": {"type": "string", "minLength": 1},
    "source_driver_entry_or_repository_hint": {"type": "string", "minLength": 1},
    "device_family": {"type": "string", "minLength": 1},
    "bus_or_transport": {"type": "string", "minLength": 1},
    "candidate_device_ids": {"type": "array", "items": {"type": "string"}},
    "intended_subset": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "excluded_variants": {"type": "array", "items": {"type": "string"}},
    "identity_status": {"const": "FROZEN"},
    "confirmation_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
