{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2r-driver.local/schemas/source-closure.schema.json",
  "title": "Frozen behaviorally required C source closure",
  "type": "object",
  "required": [
    "schema_version", "source_root", "source_revision", "closure_status", "compiler",
    "defines", "include_paths", "configuration_inputs", "generated_headers",
    "selected_conditional_branches", "translation_units", "closure_categories",
    "unresolved_dependencies"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_root": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "closure_status": {"const": "CLOSED"},
    "compiler": {
      "type": "object",
      "required": ["family", "executable", "version", "target_triple", "target_abi", "language_mode"],
      "properties": {
        "family": {"enum": ["gcc-compatible"]},
        "executable": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "target_triple": {"type": "string", "minLength": 1},
        "target_abi": {"$ref": "#/$defs/targetAbi"},
        "language_mode": {"type": "string", "minLength": 1}
      }
    },
    "defines": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "include_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "configuration_inputs": {"$ref": "#/$defs/coverage"},
    "generated_headers": {"$ref": "#/$defs/coverage"},
    "selected_conditional_branches": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    },
    "translation_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "source_path", "sha256", "compile_directory", "arguments", "dependencies"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "compile_directory": {"type": "string", "minLength": 1},
          "arguments": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256", "role"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                "role": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "closure_categories": {
      "type": "object",
      "required": ["shared_cores", "headers", "macros_configuration", "callbacks_function_pointers", "registration_tables", "source_tests", "framework_contracts"],
      "properties": {
        "shared_cores": {"$ref": "#/$defs/coverage"},
        "headers": {"$ref": "#/$defs/coverage"},
        "macros_configuration": {"$ref": "#/$defs/coverage"},
        "callbacks_function_pointers": {"$ref": "#/$defs/coverage"},
        "registration_tables": {"$ref": "#/$defs/coverage"},
        "source_tests": {"$ref": "#/$defs/coverage"},
        "framework_contracts": {"$ref": "#/$defs/coverage"}
      },
      "additionalProperties": false
    },
    "unresolved_dependencies": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "targetAbi": {
      "type": "object",
      "required": ["pointer_width_bits", "long_width_bits", "long_long_width_bits", "int_width_bits", "size_t_width_bits", "char_width_bits", "byte_order"],
      "properties": {
        "pointer_width_bits": {"type": "integer", "minimum": 1},
        "long_width_bits": {"type": "integer", "minimum": 1},
        "long_long_width_bits": {"type": "integer", "minimum": 1},
        "int_width_bits": {"type": "integer", "minimum": 1},
        "size_t_width_bits": {"type": "integer", "minimum": 1},
        "char_width_bits": {"type": "integer", "minimum": 1},
        "byte_order": {"enum": ["little", "big", "pdp"]}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["status", "paths", "rationale"],
      "properties": {
        "status": {"enum": ["COVERED", "NOT_APPLICABLE"]},
        "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string"}
      }
    }
  }
}
