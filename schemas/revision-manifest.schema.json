{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driver-port-factory.local/schemas/revision-manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "migration_envelope_sha256",
    "revision_proposal",
    "selection_job",
    "compatibility_evidence",
    "source",
    "target",
    "qemu"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "migration_envelope_sha256": {"$ref": "repository-plan.schema.json#/$defs/sha256"},
    "revision_proposal": {"$ref": "repository-plan.schema.json#/$defs/occurrence"},
    "selection_job": {"$ref": "repository-plan.schema.json#/$defs/jobBinding"},
    "compatibility_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "repository-plan.schema.json#/$defs/compatibilityEvidence"}
    },
    "source": {"$ref": "#/$defs/revision"},
    "target": {"$ref": "#/$defs/revision"},
    "qemu": {"$ref": "#/$defs/revision"}
  },
  "$defs": {
    "revision": {
      "type": "object",
      "required": ["platform", "url", "requested_ref", "revision", "selection_rule"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "requested_ref": {"type": "string", "minLength": 1},
        "revision": {"$ref": "repository-plan.schema.json#/$defs/objectId"},
        "selection_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
