{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2r-driver.local/schemas/target-change-plan.schema.json",
  "title": "Target integration and pre-existing change plan",
  "type": "object",
  "required": [
    "schema_version",
    "integration_path",
    "required_change_level",
    "driver_owned_paths",
    "proposed_preexisting_changes",
    "investigations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "integration_path": {"type": "string", "minLength": 1},
    "required_change_level": {
      "enum": ["driver-owned", "integration-wiring", "target-api-framework"]
    },
    "driver_owned_paths": {"type": "array", "minItems": 1},
    "proposed_preexisting_changes": {"type": "array"},
    "investigations": {"type": "array"}
  }
}
