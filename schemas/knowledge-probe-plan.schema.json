{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2r-driver.local/schemas/knowledge-probe-plan.schema.json",
  "title": "Knowledge readiness and target quality probe plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "probes"],
  "properties": {
    "schema_version": {"const": 1},
    "probes": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probe_id", "topic", "domain", "query", "required"],
        "properties": {
          "probe_id": {"type": "string", "minLength": 1},
          "topic": {"type": "string", "minLength": 1},
          "domain": {
            "enum": ["hardware", "source", "target", "qemu", "tooling", "test"]
          },
          "query": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "path_prefix": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "expected_record_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
