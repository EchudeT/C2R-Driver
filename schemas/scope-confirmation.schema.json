{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driver-port-factory.local/schemas/scope-confirmation.schema.json",
  "type": "object",
  "required": [
    "selected_candidate",
    "answer",
    "automatic",
    "intended_subset",
    "excluded_variants",
    "confirmation_basis",
    "identity_status"
  ],
  "properties": {
    "selected_candidate": {"type": "object"},
    "answer": {"type": "string"},
    "automatic": {"type": "boolean"},
    "intended_subset": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "excluded_variants": {"type": "array", "items": {"type": "string"}},
    "confirmation_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "identity_status": {"const": "CONFIRMED"}
  },
  "additionalProperties": true
}
