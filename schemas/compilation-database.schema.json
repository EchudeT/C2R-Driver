{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2r-driver.local/schemas/compilation-database.schema.json",
  "title": "C compilation database",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["directory", "file", "arguments"],
    "properties": {
      "directory": {"type": "string", "minLength": 1},
      "file": {"type": "string", "minLength": 1},
      "arguments": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
    }
  }
}
