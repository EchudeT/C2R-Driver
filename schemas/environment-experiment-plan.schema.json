{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2r-driver.local/schemas/environment-experiment-plan.schema.json",
  "title": "EXPERIMENT_READY route plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "milestone",
    "purpose",
    "artifact_mode",
    "route_kind",
    "device_identity",
    "topology",
    "command",
    "cwd",
    "environment",
    "timeout_seconds",
    "expected_markers",
    "accepted_exit_codes",
    "accept_timeout",
    "runner_evidence_paths",
    "relevance_evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "route_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "milestone": {"const": "EXPERIMENT_READY"},
    "purpose": {"type": "string", "minLength": 1},
    "artifact_mode": {
      "enum": [
        "verified-local-runner",
        "official-runner",
        "official-container-or-sdk",
        "prebuilt-component-insertion",
        "image-repack",
        "ci-derived-build",
        "source-build",
        "direct-device-model",
        "source-baseline"
      ]
    },
    "route_kind": {
      "enum": [
        "direct-qemu",
        "official-target-runner",
        "containerized-qemu",
        "qtest-or-qmp-harness",
        "source-baseline-runner"
      ]
    },
    "device_identity": {"type": "string", "minLength": 1},
    "topology": {"type": "string", "minLength": 1},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "cwd": {"type": "string", "minLength": 1},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "expected_markers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "accepted_exit_codes": {"type": "array", "items": {"type": "integer"}},
    "accept_timeout": {"type": "boolean"},
    "runner_evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "relevance_evidence": {"type": "string", "minLength": 1},
    "driver_insertion_or_packaging_path": {"type": ["string", "null"]}
  }
}
