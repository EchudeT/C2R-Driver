{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2r-driver.local/schemas/compile-manifest.schema.json",
  "title": "Frozen source compilation manifest",
  "type": "object",
  "required": ["schema_version", "source_revision", "source_root", "compiler", "defines", "include_paths", "selected_conditional_branches", "translation_units", "compilation_database_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "source_root": {"type": "string", "minLength": 1},
    "compiler": {
      "type": "object",
      "required": ["family", "executable", "version", "target_abi", "language_mode", "resolved_path", "sha256", "version_output_sha256"]
    },
    "defines": {"type": "array", "items": {"type": "string"}},
    "include_paths": {"type": "array", "items": {"type": "string"}},
    "selected_conditional_branches": {"type": "array", "minItems": 1},
    "translation_units": {"type": "array", "minItems": 1},
    "compilation_database_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
