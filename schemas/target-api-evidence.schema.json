{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2r-driver.local/schemas/target-api-evidence.schema.json",
  "title": "Target-facing API evidence table",
  "type": "object",
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "api_id",
          "api_or_type",
          "purpose_in_driver",
          "documented_contract",
          "execution_context",
          "ownership_lifetime_cleanup",
          "error_behavior",
          "safety_or_unsafe_obligations",
          "confidence"
        ],
        "properties": {
          "api_id": {"type": "string", "minLength": 1},
          "api_or_type": {"type": "string", "minLength": 1},
          "purpose_in_driver": {"type": "string", "minLength": 1},
          "definition_evidence": {"$ref": "#/$defs/evidenceRef"},
          "call_site_evidence": {"$ref": "#/$defs/evidenceRef"},
          "analogous_driver_evidence": {"$ref": "#/$defs/evidenceRef"},
          "documented_contract": {"type": "string", "minLength": 1},
          "execution_context": {"type": "string", "minLength": 1},
          "ownership_lifetime_cleanup": {"type": "string", "minLength": 1},
          "error_behavior": {"type": "string", "minLength": 1},
          "safety_or_unsafe_obligations": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["VERIFIED", "INFERRED", "UNKNOWN"]},
          "investigation_or_target_change_id": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "required": ["chunk_id"],
      "properties": {
        "chunk_id": {"type": "string", "minLength": 1},
        "record_id": {"type": "string"}
      }
    }
  }
}
