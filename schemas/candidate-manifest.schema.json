{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driver-port-factory.local/schemas/candidate-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "project", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "required": ["project_id", "source_platform", "target_platform", "driver_name", "evaluation_mode"]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["digest", "kind", "size", "cas_path"]
      }
    }
  },
  "additionalProperties": false
}
