{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c2r-driver.local/schemas/analogous-driver-trace.schema.json",
  "title": "Target analogous driver end-to-end trace",
  "type": "object",
  "required": [
    "schema_version",
    "selected_implementation",
    "selection_rationale",
    "framework_owners",
    "differences_not_to_copy",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "selected_implementation": {"type": "string", "minLength": 1},
    "selection_rationale": {"type": "string", "minLength": 1},
    "framework_owners": {"type": "array", "minItems": 1},
    "differences_not_to_copy": {"type": "array", "minItems": 1},
    "steps": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["stage", "status", "summary", "evidence_refs"],
        "properties": {
          "stage": {"type": "string"},
          "status": {"enum": ["VERIFIED", "NOT_APPLICABLE"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1}
        }
      }
    }
  }
}
