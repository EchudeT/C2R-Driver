{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "migration_envelope_sha256",
    "repositories",
    "compatibility_evidence"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "migration_envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repositories": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/repository"}
    },
    "compatibility_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "platform", "url", "requested_ref", "selection_rule"],
      "properties": {
        "role": {"type": "string", "enum": ["source", "target", "qemu"]},
        "platform": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "requested_ref": {
          "type": "string",
          "pattern": "^((refs/tags/)?[vV]?[0-9]+(\\.[0-9]+)+([-._][A-Za-z0-9]+)*|[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "selection_rule": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "claim", "excerpt", "claim_kind", "bindings", "max_bytes"],
      "properties": {
        "source_url": {"type": "string", "pattern": "^https?://"},
        "claim": {"type": "string", "minLength": 1},
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "description": "An exact byte-for-byte contiguous substring of the retrieved response. For JSON or XML, use a minimal value token that does not depend on indentation or separator whitespace."
        },
        "claim_kind": {
          "type": "string",
          "enum": ["maintenance", "cross-repository-compatibility"]
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/binding"}
        },
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "requested_ref"],
      "properties": {
        "role": {"type": "string", "enum": ["source", "target", "qemu"]},
        "requested_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
