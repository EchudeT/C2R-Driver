{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "artifact_mode", "cwd", "build", "inspect", "base_artifact", "final_artifact", "packaged_test_artifact", "presence_manifest", "tool_evidence_paths"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string"},
    "artifact_mode": {"type": "string"},
    "cwd": {"type": "string"},
    "build": {"$ref": "#/$defs/command"},
    "inspect": {"$ref": "#/$defs/command"},
    "base_artifact": {"type": "string"},
    "final_artifact": {"type": "string"},
    "packaged_test_artifact": {"type": "string"},
    "presence_manifest": {"type": "string"},
    "tool_evidence_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "environment", "timeout_seconds", "accepted_exit_codes"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "accepted_exit_codes": {"type": "array", "minItems": 1, "items": {"type": "integer"}}
      }
    }
  }
}
