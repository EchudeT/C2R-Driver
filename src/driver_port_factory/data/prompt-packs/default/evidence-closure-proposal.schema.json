{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dpf:acquisition:evidence-discovery-proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "migration_envelope_sha256", "repository_manifest_sha256", "facets"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "migration_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "repository_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "facets": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "anyOf": [
          {"$ref": "#/$defs/controlled_facet"},
          {"$ref": "#/$defs/gap_facet"}
        ]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1
    },
    "http_url": {"type": "string", "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$"},
    "lane": {
      "type": "string",
      "enum": ["source", "target", "qemu", "hardware", "test", "tooling"]
    },
    "facet_name": {
      "type": "string",
      "enum": [
        "driver_entry",
        "dependency_closure",
        "framework_contracts",
        "build_configuration",
        "extension_points",
        "driver_framework",
        "analogous_implementations",
        "api_definitions_and_calls",
        "lifecycle",
        "artifact_runtime_path",
        "coding_and_safety_rules",
        "test_conventions",
        "release_assets",
        "device_model",
        "device_model_documentation",
        "observability_and_injection",
        "device_manual",
        "register_state_machine",
        "bus_specification",
        "errata",
        "source_tests",
        "test_framework_documentation",
        "toolchain_documentation",
        "packaging_and_release_documentation",
        "runtime_documentation"
      ]
    },
    "controlled_facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "facet", "disposition", "rationale", "locators"],
      "properties": {
        "lane": {"$ref": "#/$defs/lane"},
        "facet": {"$ref": "#/$defs/facet_name"},
        "disposition": {"type": "string", "const": "CONTROLLED"},
        "rationale": {"type": "string", "minLength": 1},
        "locators": {"$ref": "#/$defs/locators"}
      }
    },
    "gap_facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "facet", "disposition", "rationale", "locators", "gap"],
      "properties": {
        "lane": {"$ref": "#/$defs/lane"},
        "facet": {"$ref": "#/$defs/facet_name"},
        "disposition": {"type": "string", "const": "EXPLICIT_GAP"},
        "rationale": {"type": "string", "minLength": 1},
        "locators": {"$ref": "#/$defs/locators"},
        "gap": {"$ref": "#/$defs/gap"}
      }
    },
    "locators": {
      "type": "array",
      "items": {
        "anyOf": [
          {"$ref": "#/$defs/git_blob_original"},
          {"$ref": "#/$defs/git_blob_derived"},
          {"$ref": "#/$defs/external_reference"},
          {"$ref": "#/$defs/external_url_original"},
          {"$ref": "#/$defs/external_url_derived"}
        ]
      }
    },
    "git_blob_original": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "path", "license", "redistribution", "original"],
      "properties": {
        "kind": {"type": "string", "const": "git_blob"},
        "repository": {"$ref": "#/$defs/repository_role"},
        "path": {"$ref": "#/$defs/relative_path"},
        "license": {"type": "string", "minLength": 1},
        "redistribution": {"$ref": "#/$defs/redistribution"},
        "original": {"type": "boolean", "const": true}
      }
    },
    "git_blob_derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "path", "license", "redistribution", "original", "derived_from", "original_path", "page_map"],
      "properties": {
        "kind": {"type": "string", "const": "git_blob"},
        "repository": {"$ref": "#/$defs/repository_role"},
        "path": {"$ref": "#/$defs/relative_path"},
        "license": {"type": "string", "minLength": 1},
        "redistribution": {"$ref": "#/$defs/redistribution"},
        "original": {"type": "boolean", "const": false},
        "derived_from": {"type": "string", "minLength": 1},
        "original_path": {"$ref": "#/$defs/relative_path"},
        "page_map": {"type": "string", "minLength": 1}
      }
    },
    "external_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_url", "max_bytes"],
      "properties": {
        "kind": {"type": "string", "const": "external_reference"},
        "source_url": {"$ref": "#/$defs/http_url"},
        "max_bytes": {"$ref": "#/$defs/max_bytes"}
      }
    },
    "external_url_original": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_url", "revision", "expected_sha256", "max_bytes", "authority", "license", "redistribution", "original"],
      "properties": {
        "kind": {"type": "string", "const": "external_url"},
        "source_url": {"$ref": "#/$defs/http_url"},
        "revision": {"type": "string", "minLength": 1},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "max_bytes": {"$ref": "#/$defs/max_bytes"},
        "authority": {"$ref": "#/$defs/authority"},
        "license": {"type": "string", "minLength": 1},
        "redistribution": {"$ref": "#/$defs/redistribution"},
        "original": {"type": "boolean", "const": true}
      }
    },
    "external_url_derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_url", "revision", "expected_sha256", "max_bytes", "authority", "license", "redistribution", "original", "derived_from", "original_path", "page_map"],
      "properties": {
        "kind": {"type": "string", "const": "external_url"},
        "source_url": {"$ref": "#/$defs/http_url"},
        "revision": {"type": "string", "minLength": 1},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "max_bytes": {"$ref": "#/$defs/max_bytes"},
        "authority": {"$ref": "#/$defs/authority"},
        "license": {"type": "string", "minLength": 1},
        "redistribution": {"$ref": "#/$defs/redistribution"},
        "original": {"type": "boolean", "const": false},
        "derived_from": {"type": "string", "minLength": 1},
        "original_path": {"$ref": "#/$defs/relative_path"},
        "page_map": {"type": "string", "minLength": 1}
      }
    },
    "repository_role": {"type": "string", "enum": ["source", "target", "qemu"]},
    "redistribution": {"type": "string", "enum": ["allowed", "restricted", "unknown"]},
    "max_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
    "authority": {
      "anyOf": [
        {"$ref": "#/$defs/repository_endorsement"},
        {"$ref": "#/$defs/corroborated_authority"}
      ]
    },
    "repository_endorsement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "path", "line_start", "line_end"],
      "properties": {
        "kind": {"type": "string", "const": "repository_endorsement"},
        "repository": {"$ref": "#/$defs/repository_role"},
        "path": {"$ref": "#/$defs/relative_path"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1}
      }
    },
    "corroborated_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sources"],
      "properties": {
        "kind": {"type": "string", "const": "corroborated"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/corroboration_source"}
        }
      }
    },
    "corroboration_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "expected_sha256", "max_bytes"],
      "properties": {
        "source_url": {"$ref": "#/$defs/http_url"},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "max_bytes": {"$ref": "#/$defs/max_bytes"}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "impact", "repair_trigger"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["NOT_FOUND", "ACCESS_RESTRICTED", "LICENSE_UNCERTAIN", "CONFLICTING_SOURCES", "UNAVAILABLE_PUBLIC_EVIDENCE"]
        },
        "impact": {"type": "string", "minLength": 1},
        "repair_trigger": {"type": "string", "minLength": 1}
      }
    }
  }
}
