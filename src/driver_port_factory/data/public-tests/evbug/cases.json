[
  {
    "id": "evbug-events",
    "case": {
      "devices": [],
      "timeout_seconds": 120,
      "steps": [
        {
          "wait_serial": "# "
        },
        {
          "guest_assert": "printf '%s\\n' 'events' > /proc/evbug_test"
        },
        {
          "wait_serial": "DPF_EVBUG_DONE events"
        },
        {
          "assert_serial_matches": {
            "pattern": "evbug: Event\\. Dev: (dpf-[^,\\r\\n]+), Type: (\\d+), Code: (\\d+), Value: (-?\\d+)",
            "expected": [
              [
                "dpf-events",
                "1",
                "30",
                "1"
              ],
              [
                "dpf-events",
                "2",
                "0",
                "-7"
              ],
              [
                "dpf-events",
                "0",
                "0",
                "0"
              ]
            ]
          }
        },
        {
          "assert_serial_matches": {
            "pattern": "evbug: (Connected|Disconnected) device: (dpf-[^\\s(]+)",
            "expected": [
              [
                "Connected",
                "dpf-events"
              ],
              [
                "Disconnected",
                "dpf-events"
              ]
            ]
          }
        }
      ]
    }
  },
